{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".adonisjs/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "@monkimoney/api#build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["build/**", ".adonisjs/**"],
      "env": ["NODE_ENV"]
    },
    "@monkimoney/web#build": {
      "dependsOn": ["^build", "@monkimoney/api#codegen"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DB_*", "S3_*"]
    },
    "@monkimoney/api#test": {
      "dependsOn": ["^build", "codegen"],
      "cache": false,
      "env": ["DB_*", "S3_*"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@monkimoney/api#typecheck": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "@monkimoney/web#typecheck": {
      "dependsOn": ["^build", "@monkimoney/api#codegen"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
