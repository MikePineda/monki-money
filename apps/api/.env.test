# Committed on purpose: test-only values, no real secrets. Loaded on top of
# `.env` when NODE_ENV=test (Japa). In CI there is no `.env`, so every
# required variable of start/env.ts must have a value here or in the job env.
TZ=UTC
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=error
# Fixed test-only key (not used anywhere else).
APP_KEY=test-only-app-key-0123456789abcdef
APP_URL=http://127.0.0.1:3333
APP_NAME=monkimoney
REGISTRATION_OPEN=true
SESSION_DRIVER=memory
LIMITER_STORE=memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=monkimoney
DB_PASSWORD=monkimoney
DB_DATABASE=monkimoney_test
DRIVE_DISK=fs
QUEUE_DRIVER=sync
LLM_PROVIDER=fake
LLM_API_KEY=
MAIL_DRIVER=log
