meta {
  name: Create a goal without an account
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/goals
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno jar {{runId}}",
    "targetCents": 50000,
    "startingCents": 10000,
    "monthlyContributionCents": 5000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('manualGoalId', res.body.data.id)
  }
}

assert {
  res.status: eq 201
  res.body.data.accountId: isNull
  res.body.data.startingCents: eq 10000
}

docs {
  `goals.store` without `accountId`: what it saves is `startingCents` plus
  its contributions (the next requests).
}
