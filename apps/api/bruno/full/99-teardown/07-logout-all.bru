meta {
  name: Log out everywhere
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/logout-all
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  `auth.logout_all`: 204, bumps the user's session version, so every device
  (this run's cookie included) is logged out.
}
