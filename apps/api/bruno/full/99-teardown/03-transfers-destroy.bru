meta {
  name: Delete the transfer
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/transfers/{{transferId}}
  body: none
  auth: none
}

script:pre-request {
  // Nothing to clean up when the request that sets it did not run.
  if (!bru.getVar('transferId')) {
    bru.runner.skipRequest()
  }
}

assert {
  res.status: eq 204
}

docs {
  `transfers.destroy`: removes both legs.
}
