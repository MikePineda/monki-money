meta {
  name: Delete the expense
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/transactions/{{expenseId}}
  body: none
  auth: none
}

script:pre-request {
  // Nothing to clean up when the request that sets it did not run.
  if (!bru.getVar('expenseId')) {
    bru.runner.skipRequest()
  }
}

assert {
  res.status: eq 204
}

docs {
  `transactions.destroy`: 204 (split lines go with it); transfer legs 409.
}
