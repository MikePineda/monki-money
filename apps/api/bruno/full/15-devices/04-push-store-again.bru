meta {
  name: Register it again
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/push/subscriptions
  body: json
  auth: none
}

body:json {
  {
    "endpoint": "https://fcm.googleapis.com/fcm/send/bruno-{{runId}}",
    "expirationTime": null,
    "keys": {
      "p256dh": "BAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0A",
      "auth": "oKGio6SlpqeoqaqrrK2urw"
    }
  }
}

assert {
  res.status: eq 200
  res.body.data.endpoint: eq https://fcm.googleapis.com/fcm/send/bruno-{{runId}}
}

docs {
  `push.subscriptions.store` with the same endpoint: 200, keys and user agent
  refreshed (at most 10 devices per person).
}
