meta {
  name: Forgot password (unknown address)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "bruno-{{runId}}@example.test"
  }
}

assert {
  res.status: eq 200
  res.body.data.requested: eq true
}

docs {
  `auth.password.forgot`: always 200 `{ requested: true }`, whether the
  address exists or not (no enumeration). A fresh synthetic address per run,
  so the 5 per minute per IP + email limit never trips. The reset itself
  (`auth.password.reset`) needs the mailed token: allowlisted.
}
