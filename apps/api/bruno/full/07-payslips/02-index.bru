meta {
  name: Payslips of the wallet
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/payslips?accountId={{accountBId}}
  body: none
  auth: none
}

params:query {
  accountId: {{accountBId}}
}

assert {
  res.status: eq 200
  res.body.data.length: eq 1
  res.body.data[0].id: eq {{payslipId}}
}

docs {
  `payslips.index`: `?accountId=` (optional) → `Payslip[]`, newest first.
}
