meta {
  name: Create the wallet
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno wallet {{runId}}",
    "kind": "wallet",
    "ownerUserId": {{userId}}
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('accountBId', res.body.data.id)
  }
}

assert {
  res.status: eq 201
  res.body.data.kind: eq wallet
  res.body.data.ownerUserId: eq {{userId}}
}

docs {
  `accounts.store`: a personal wallet (the umbrella service of a payslip).
}
