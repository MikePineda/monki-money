meta {
  name: Reorder groups (same order)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/category-groups/reorder
  body: json
  auth: none
}

body:json {
  {
    "ids": []
  }
}

script:pre-request {
  req.setBody({ ids: JSON.parse(bru.getVar('groupOrder') || '[]') })
}

assert {
  res.status: eq 204
}

docs {
  `category_groups.reorder`: `{ ids }` → 204. The current order: nothing moves.
}
