meta {
  name: Create a category
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

body:json {
  {
    "categoryGroupId": {{groupId}},
    "name": "Bruno category {{runId}}",
    "icon": "star"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('categoryId', res.body.data.id)
  }
}

assert {
  res.status: eq 201
  res.body.data.categoryGroupId: eq {{groupId}}
  res.body.data.isSystem: eq false
}

docs {
  `categories.store`: `{ categoryGroupId, name, icon?, isHidden? }` → 201.
}
