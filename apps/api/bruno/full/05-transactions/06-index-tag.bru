meta {
  name: Transactions (by tag)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/transactions?tag=bruno-{{runId}}
  body: none
  auth: none
}

params:query {
  tag: bruno-{{runId}}
}

assert {
  res.status: eq 200
  res.body.data.length: eq 1
}

tests {
  test('matches the exact tag', () => {
    expect(res.body.data[0].id).to.equal(bru.getVar('expenseId'))
  })
}

docs {
  `transactions.index?tag=`: the exact tag (case included), every date.
}
