meta {
  name: Undo the decision (bulk)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/imports/{{importId}}/rows
  body: json
  auth: none
}

body:json {
  {
    "changes": [
      { "rowId": {{importRowId}}, "reset": true }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.data.length: eq 1
  res.body.data[0].resolution: eq {{importRowResolution}}
}

docs {
  `imports.rows.bulk`: `{ changes: [{ rowId, ...rows.update fields }] }`
  (1 to 5 000) in one database transaction; `reset: true` puts a row back as
  the importer proposed it (the review's "Undo").
}
