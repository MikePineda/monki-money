meta {
  name: Upload the same file again
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/imports
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(../tests/fixtures/nab/pending-then-posted.csv)
  accountId: {{accountAId}}
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('confirmImportId', res.body.data[0].id)
  }
}

assert {
  res.status: eq 201
  res.body.data[0].status: eq staged
}

docs {
  `imports.store` again: a cancelled batch frees the file.
}
