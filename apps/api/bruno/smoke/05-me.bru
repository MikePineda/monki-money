meta {
  name: Current session
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.membership.role: eq owner
  res.body.data.entitlements: isDefined
  res.body.data.members: isArray
}

tests {
  test('is the smoke user in its own smoke household', () => {
    expect(res.body.data.user.email).to.equal(bru.getProcessEnv('SMOKE_EMAIL').trim().toLowerCase())
    expect(res.body.data.household.name).to.equal(bru.getEnvVar('smokeHousehold'))
  })
}

docs {
  `auth.me`: the SPA's boot call. `{ data: { user, household, membership,
  entitlements, flags, members, partner } }`; 401 for guests (who still get the XSRF-TOKEN
  cookie). The smoke user owns the "Smoke" household (created by the
  production bootstrap seeder from SMOKE_EMAIL / SMOKE_PASSWORD).
}
