# monkimoney API environment. Copy to `.env` for local development:
#   cp apps/api/.env.example apps/api/.env && (cd apps/api && node ace generate:key)
# Values below work with the root docker-compose.yml. Production values live
# ONLY in the Dokploy panel (never in the repo). Every variable is validated in
# start/env.ts; keep both files in sync. Empty optional values mean "off".

#--------------------------------------------------------------------
# Node / HTTP
#--------------------------------------------------------------------
TZ=UTC
NODE_ENV=development
# Container: 0.0.0.0
HOST=localhost
PORT=3333
LOG_LEVEL=info

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
# Generate with `node ace generate:key`. Rotating it invalidates every session.
APP_KEY=
# Production: https://app.example.com
APP_URL=http://localhost:3333
APP_NAME=monkimoney
# Empty = derived inside the Docker image (.app-version / .git-sha files)
APP_VERSION=
GIT_SHA=
# Public sign-up. Closed by default; opening it = flip this + redeploy.
REGISTRATION_OPEN=false
# Registers the E2E-only routes/commands outside NODE_ENV=test. Never in production.
E2E_MODE=
# Locale used when neither the user nor the browser picks a supported one: en | es
APP_DEFAULT_LOCALE=en

#--------------------------------------------------------------------
# Session and rate limiting (tests use memory for both)
#--------------------------------------------------------------------
SESSION_DRIVER=cookie
LIMITER_STORE=database

#--------------------------------------------------------------------
# Cloudflare Turnstile (only used while REGISTRATION_OPEN=true;
# empty secret = verification skipped)
#--------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

#--------------------------------------------------------------------
# Database (Postgres 17). Production: DB_HOST=monkimoney-db (internal network)
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=monkimoney
DB_PASSWORD=monkimoney
DB_DATABASE=monkimoney
DB_POOL_MAX=10

#--------------------------------------------------------------------
# Object storage, S3-compatible. Production: Cloudflare R2
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
# Local: MinIO from docker-compose.yml (host port 9030). Empty DRIVE_DISK = files are parsed in
# memory and not persisted (S3 does not block the go-live).
#--------------------------------------------------------------------
DRIVE_DISK=s3
S3_ENDPOINT=http://127.0.0.1:9030
S3_REGION=us-east-1
S3_BUCKET=monkimoney
S3_KEY=monkimoney
S3_SECRET=monkimoney-secret
S3_FORCE_PATH_STYLE=true

#--------------------------------------------------------------------
# Background jobs (sync = inline until a worker exists)
#--------------------------------------------------------------------
QUEUE_DRIVER=sync

#--------------------------------------------------------------------
# LLM provider (Anthropic-compatible endpoint). Empty LLM_API_KEY = no LLM;
# the app keeps working and classification degrades to rules only.
# Production base URL: https://api.minimax.io/anthropic
#--------------------------------------------------------------------
LLM_PROVIDER=anthropic-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
LLM_VISION_MODEL=
LLM_MONTHLY_CAP_OVERRIDE=

#--------------------------------------------------------------------
# Mail: log | resend | smtp. Empty provider key = silent no-op.
# Production: MAIL_DRIVER=resend, MAIL_FROM="monkimoney <noreply@mail.example.com>"
# SMTP_* is optional (e.g. Mailtrap for manual testing).
#--------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

#--------------------------------------------------------------------
# Observability (Sentry; the web DSN is served to the SPA by GET /api/v1/config)
#--------------------------------------------------------------------
SENTRY_DSN=
SENTRY_DSN_WEB=

#--------------------------------------------------------------------
# Deploy-time bootstrap (docker/entrypoint.mjs)
# MIGRATE_ON_START: run `migration:run --force` before the server starts.
# SEED_USERS: run the idempotent production bootstrap seeder
#   (database/seeders/production_bootstrap_seeder). First deploy only;
#   afterwards set it to false and delete the SEED_*_PASSWORD values.
# The seeder creates the household SEED_HOUSEHOLD_NAME (locale SEED_LOCALE),
# user 1 as owner and user 2 (optional) as member, both verified, plus the
# accounts: a joint everyday account (bank account number
# SEED_JOINT_ACCOUNT_NUMBER, one card per user from SEED_USER{1,2}_CARD_SUFFIX),
# a joint savings account, a wallet owned by user 1 and joint cash.
# Idempotent by email / name: re-running never duplicates nor resets passwords.
# Real names, emails and numbers live ONLY in the Dokploy panel, never here.
# Any SEED_* household variable set (SEED_LOCALE aside) makes the whole block
# required; leave them all empty to seed only the smoke user.
# SMOKE_EMAIL / SMOKE_PASSWORD: the smoke-test user of the Bruno collection
#   (apps/api/bruno). With SEED_USERS=true the seeder creates it verified, alone
#   in its own "Smoke" household with no accounts, so smoke runs never touch
#   the real household. Must differ from every SEED_USER*_EMAIL.
#--------------------------------------------------------------------
MIGRATE_ON_START=false
SEED_USERS=false
SEED_HOUSEHOLD_NAME=
SEED_LOCALE=en
SEED_USER1_EMAIL=
SEED_USER1_NAME=
SEED_USER1_PASSWORD=
SEED_USER1_CARD_SUFFIX=
SEED_USER2_EMAIL=
SEED_USER2_NAME=
SEED_USER2_PASSWORD=
SEED_USER2_CARD_SUFFIX=
SEED_JOINT_ACCOUNT_NUMBER=
SMOKE_EMAIL=
SMOKE_PASSWORD=
