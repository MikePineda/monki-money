{
  "name": "@monkimoney/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint . && prettier --check src && prettier --check \"*.json\" && npm run lint:i18n",
    "lint:i18n": "transloco-keys-manager find --emit-error-on-extra-keys",
    "format": "prettier --write src \"*.json\"",
    "icons": "node scripts/build-icon-sprite.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@jsverse/transloco": "8.4.0",
    "@monkimoney/shared": "*",
    "@tuyau/core": "1.2.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "lucide-static": "1.61.0",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "prettier": "@adonisjs/prettier-config"
}
