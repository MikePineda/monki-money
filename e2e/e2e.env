# Environment of the API during `npm run e2e`. Committed: throwaway values for
# the ephemeral docker-compose.test.yml stack only (Postgres 5433, MinIO 9100).
# Loaded by playwright.config.ts (webServer) and by scripts/e2e.sh (migrations).
NODE_ENV=test
E2E_MODE=true
TZ=UTC
HOST=127.0.0.1
PORT=3334
LOG_LEVEL=warn
APP_KEY=e2e-only-app-key-0123456789abcdef
APP_URL=http://127.0.0.1:3334
APP_NAME=monkimoney
REGISTRATION_OPEN=true
SESSION_DRIVER=cookie
LIMITER_STORE=memory
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=monkimoney
DB_PASSWORD=monkimoney
DB_DATABASE=monkimoney_e2e
DRIVE_DISK=s3
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=monkimoney-e2e
S3_KEY=monkimoney
S3_SECRET=monkimoney-secret
S3_FORCE_PATH_STYLE=true
QUEUE_DRIVER=sync
LLM_PROVIDER=fake
MAIL_DRIVER=log
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The site key (Cloudflare's always-pass test key) makes the web render the
# widget, so every auth journey waits for its token. The browser gets a
# stand-in for Cloudflare's script (e2e/support/turnstile.ts explains why) and
# the secret stays empty, so the API skips siteverify: no Cloudflare in E2E.
TURNSTILE_SECRET=
